{
  "permissions": {
    "deny": [
      "Read(~/.zprofile)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zprofile)",
      "Read(**/.env)",
      "Edit(**/.env)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(git push *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}